# ---------------------------------------------------------------------------
# Zihin — docker compose ortam değişkenleri.
#
#   cp docker/.env.example docker/.env
#   node scripts/generate-keys.mjs --write      # sırları üretir ve yazar
#
# docker/.env dosyası sürüm kontrolüne GİRMEZ (.gitignore kapsıyor).
# ---------------------------------------------------------------------------

# === PORTLAR ===============================================================
# Hepsi 14xxx aralığında; makinedeki başka servislerle çakışmasın diye.
# Değiştirirseniz PUBLIC_API_URL ve PUBLIC_APP_URL değerlerini de güncelleyin.

PORT_WEB=14000          # Zihin uygulaması        → http://localhost:14000
PORT_API=14001          # Supabase API ağ geçidi  → NEXT_PUBLIC_SUPABASE_URL
PORT_DB=14002           # PostgreSQL              → psql ile doğrudan erişim
PORT_STUDIO=14003       # Supabase Studio         → tabloları görsel yönetim
PORT_MAIL_UI=14004      # Mailpit arayüzü         → giden tüm e-postalar burada
PORT_MAIL_SMTP=14005    # Mailpit SMTP            → uygulama buraya gönderir

# === ERİŞİM ADRESLERİ ======================================================
# VM'de çalıştırıyorsanız `localhost` yerine VM'nin IP adresini ya da alan
# adını yazın. Tarayıcı bu adreslere DOĞRUDAN bağlanır; konteyner adları
# (`db`, `auth`) tarayıcıdan çözülmez.
#
#   Örnek:  PUBLIC_API_URL=http://192.168.1.50:14001
#           PUBLIC_APP_URL=http://192.168.1.50:14000

PUBLIC_API_URL=http://localhost:14001
PUBLIC_APP_URL=http://localhost:14000

# === SIRLAR ================================================================
# BUNLARI ELLE DOLDURMAYIN — `node scripts/generate-keys.mjs --write` üretir.
#
# ANON_KEY ve SERVICE_ROLE_KEY, JWT_SECRET ile imzalanmış JWT'lerdir; üçü
# birbirine bağlıdır, birini değiştirirseniz üçünü birden yenileyin.
# İnternette dolaşan "demo" anahtarların gizli anahtarı herkesçe bilinir.

POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
CRON_SECRET=
DASHBOARD_PASSWORD=
SECRET_KEY_BASE=

# === UYGULAMA ==============================================================

NEXT_PUBLIC_APP_NAME=Zihin
NEXT_PUBLIC_BRAND_HUE=243

# Kayıt sırasında e-posta doğrulaması istensin mi.
# false yaparsanız kayıt olan hesap anında kullanılabilir — demo için pratik,
# üretimde açık bırakın.
ENABLE_EMAIL_AUTOCONFIRM=false

# Seed verisi (test hesapları + demo aktivite) yüklensin mi.
# Üretimde false yapın: test hesapları bilinen şifrelerle gelir.
SEED_DATABASE=true

# === E-POSTA ===============================================================
# Varsayılan olarak tüm e-postalar Mailpit'e düşer ve http://localhost:14004
# adresinden okunur; dışarıya hiçbir şey gitmez.
# Gerçek gönderim için RESEND_API_KEY doldurun.

RESEND_API_KEY=
EMAIL_FROM=Zihin <bilgi@zihin.local>

# === ÖDEME (iyzico sandbox) ================================================
# Boş bırakılırsa sahte sağlayıcı devreye girer ve arayüzde "test ödemesi"
# uyarısı gösterilir — gerçekmiş gibi davranmaz.

IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# === VİDEO =================================================================
VIDEO_PROVIDER=supabase
SUPABASE_VIDEO_BUCKET=videos
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_PULL_ZONE=
BUNNY_TOKEN_KEY=

# === İMAJ SÜRÜMLERİ ========================================================
# Bir imaj çekilemezse (404) buradan sürümü yükseltin. Kontrol için:
#   docker pull supabase/gotrue:v2.170.0

IMAGE_POSTGRES=supabase/postgres:15.8.1.060
IMAGE_GOTRUE=supabase/gotrue:v2.170.0
IMAGE_POSTGREST=postgrest/postgrest:v12.2.8
IMAGE_STORAGE=supabase/storage-api:v1.19.3
IMAGE_IMGPROXY=darthsim/imgproxy:v3.8.0
IMAGE_META=supabase/postgres-meta:v0.87.1
IMAGE_STUDIO=supabase/studio:20250224-d10db0f
IMAGE_NGINX=nginx:1.27-alpine
IMAGE_MAILPIT=axllent/mailpit:v1.21
