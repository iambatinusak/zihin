{
  "name": "@zihin/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./seed/*": "./seed/*.ts"
  },
  "scripts": {
    "build": "echo \"@zihin/db is consumed as source (transpilePackages)\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src seed scripts --ext .ts --no-error-on-unmatched-pattern",
    "test": "vitest run --passWithNoTests",
    "db:reset": "tsx scripts/reset.ts",
    "db:push": "tsx scripts/push.ts",
    "db:types": "node scripts/gen-types.mjs",
    "seed": "tsx seed/index.ts",
    "export:content": "tsx scripts/export-content.ts",
    "verify": "node scripts/verify-schema.mjs",
    "verify:inspect": "node scripts/verify-schema.mjs --inspect",
    "smoke": "node scripts/smoke-schema.mjs",
    "test:rls": "node scripts/test-rls.mjs",
    "check:content": "tsx scripts/check-content.ts",
    "test:seed": "node scripts/test-seed.mjs",
    "migrate": "node scripts/migrate.mjs",
    "test:migrate": "node scripts/test-migrate.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "@zihin/core": "workspace:^"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.7",
    "embedded-postgres": "17.10.0-beta.17",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
