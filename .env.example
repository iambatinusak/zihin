# ---------------------------------------------------------------------------
# Zihin — ortam değişkenleri şablonu.
# Bu dosyayı ".env.local" olarak kopyalayın ve değerleri doldurun.
#   cp .env.example .env.local
# HİÇBİR GERÇEK ANAHTARI BU DOSYAYA YAZMAYIN.
# ---------------------------------------------------------------------------

# --- Marka / uygulama ------------------------------------------------------
# Kullanıcıya görünen ürün adı. Tüm arayüzde bu değer kullanılır.
NEXT_PUBLIC_APP_NAME=Zihin
# Uygulamanın tam adresi (e-posta bağlantıları, OAuth yönlendirmesi, iyzico dönüşü).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Ana marka rengi (Tailwind/CSS değişkenine işlenir). HSL "H S% L%" biçimi.
NEXT_PUBLIC_BRAND_HUE=243

# --- Supabase --------------------------------------------------------------
# `supabase start` çıktısındaki API URL'i (yerel: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# `supabase start` çıktısındaki anon key. Tarayıcıya gönderilir; korumayı RLS sağlar.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key. SADECE sunucu tarafında. Asla NEXT_PUBLIC_ yapmayın.
SUPABASE_SERVICE_ROLE_KEY=
# Migration/seed için doğrudan Postgres bağlantısı (yerel varsayılan aşağıda).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- E-posta (Resend) ------------------------------------------------------
# Boş bırakılırsa e-postalar konsola yazılır (geliştirme için "log" sağlayıcısı).
RESEND_API_KEY=
EMAIL_FROM=Zihin <bilgi@example.com>

# --- Ödeme (iyzico sandbox) ------------------------------------------------
# Boş bırakılırsa ödeme "sahte" sağlayıcıyla çalışır (geliştirme için).
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# --- Video -----------------------------------------------------------------
# supabase | bunny
VIDEO_PROVIDER=supabase
# Supabase Storage bucket adı (VIDEO_PROVIDER=supabase için)
SUPABASE_VIDEO_BUCKET=videos
# Bunny Stream (VIDEO_PROVIDER=bunny için)
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_PULL_ZONE=
BUNNY_TOKEN_KEY=

# --- Cron ------------------------------------------------------------------
# /api/cron/* uçlarını korur. `Authorization: Bearer <CRON_SECRET>` beklenir.
CRON_SECRET=dev-cron-secret-degistirin

# --- Gözlemlenebilirlik (opsiyonel) ---------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
